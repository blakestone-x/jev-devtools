{
  "name": "jev-devtools-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm run build:package && npm run dev -w @jev-devtools/playground",
    "build:package": "npm run build -w jev-devtools",
    "build": "npm run build:package && npm run build -w @jev-devtools/playground",
    "check": "npm run build:package && npm run check --workspaces",
    "test": "npm run build:package && npm test --workspaces",
    "verify:package": "node scripts/verify-package.mjs",
    "check:playground": "node scripts/check-playground.mjs",
    "pack:devtools": "npm pack -w jev-devtools --pack-destination .",
    "verify:nextjs": "node scripts/verify-nextjs.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
