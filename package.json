{
  "name": "@diagram-motion-lab/jev-devtools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "test": "node --import tsx --test tests/*.test.ts",
    "build:package": "tsc -p tsconfig.lib.json && node scripts/copy-styles.mjs",
    "prepack": "npm run build:package",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.7.0"
  },
  "devDependencies": {
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "description": "A React drawer and Node server adapter for inspecting TypeSafe Jev requests.",
  "exports": {
    ".": {
      "types": "./lib/src/index.d.ts",
      "import": "./lib/src/index.js"
    },
    "./server": {
      "types": "./lib/server/index.d.ts",
      "import": "./lib/server/index.js"
    },
    "./styles.css": "./lib/src/inspector.css"
  },
  "files": [
    "lib",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  }
}
